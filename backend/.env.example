# Copy to .env and fill in. .env is gitignored.
PROJECT_NAME=bp-maplestory
API_V1_PREFIX=/api/v1
DEBUG=false

# Must match infra/.env -- the same postgres the dlt and dbt projects use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=...
POSTGRES_PASSWORD=...
# The database is the environment boundary: dev_maplestory or prod_maplestory.
# It stays on dev until Dagster keeps prod current.
POSTGRES_DB=dev_maplestory

# Schema this service owns and migrates (backend/migrations).
APP_SCHEMA=app
# Schema dbt builds, read-only from here. Same name in every environment --
# only POSTGRES_DB above changes.
MARTS_SCHEMA=marts
