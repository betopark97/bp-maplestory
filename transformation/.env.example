# Copy to .env and fill in. .env is gitignored.
# Sourced by the Makefile before dbt runs -- dbt Core does not read a .env itself.
# Must match infra/.env: the same Postgres that dlt writes and the backend reads.
#
# The database is NOT here. It comes from the dbt target (`-t dev` / `-t prod`),
# which is what makes the environment an explicit choice at run time.
# Single-quote every value. The Makefile sources this file, so a password
# containing &, ^ or $ is otherwise interpreted by the shell.
POSTGRES_HOST='localhost'
POSTGRES_PORT='5432'
POSTGRES_USER='...'
POSTGRES_PASSWORD='...'
