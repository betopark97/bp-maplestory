# Copy to .env and adjust. infra/.env is gitignored.
# docker compose auto-loads .env from this directory.
POSTGRES_USER=...
POSTGRES_PASSWORD=...
# The bootstrap database: the entrypoint creates it on an empty volume and the
# healthcheck connects to it. It is also the dev environment's database -- the
# environment lives in the database name, and every database holds the same
# schemas. The others come from initdb/01-databases.sql.
POSTGRES_DB=dev_maplestory
POSTGRES_PORT=5432

# MinIO bucket configuration. MINIO_ROOT_PASSWORD must be >= 8 chars or MinIO won't start.
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD double as the S3 access key / secret key.
MINIO_ROOT_USER=...
MINIO_ROOT_PASSWORD=...
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
