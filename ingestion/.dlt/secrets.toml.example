# -------------------------------------------------------------------------------------
# Source credentials
# -------------------------------------------------------------------------------------
[sources.nexon]
# X_NXOPEN_API_KEY
api_key = "test_..."

# MinIO, or any S3-compatible object store. Read by the object_storage source and,
# through minio_fs(), by the extraction notebooks that write into the bucket.
[sources.object_storage.credentials]
aws_access_key_id = "..."
aws_secret_access_key = "..."
endpoint_url = "http://..."

# -------------------------------------------------------------------------------------
# Destination credentials
# -------------------------------------------------------------------------------------
[destination.postgres.credentials]
# `database` is NOT set here. It comes from the active profile's
# {profile}.config.toml, which is what makes dev/tests/prod one switch.
host = "localhost"
port = 5432
username = "..."
password = "..."
